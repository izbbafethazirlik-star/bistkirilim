# --- Zorunlu (yoksa bot DRY_RUN modunda çalışır, sadece loglar) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Depolama: Railway'de Volume'u /data'ya bağlayın ---
DATA_DIR=/data

# --- Strateji seçimi ---
# breakout, breakout_retest, trend_pullback, support_bounce, squeeze
ENABLED_STRATEGIES=breakout,breakout_retest,trend_pullback
# TIMEFRAMES=1h,1d
# SYMBOLS=THYAO,ASELS,GARAN

# --- Maliyet (tek yön, %) ---
# COMMISSION_PCT=0.08
# SLIPPAGE_PCT=0.05

# --- Risk ---
# MIN_AVG_TURNOVER_TL=20000000
# MIN_QUALITY=60
# TARGET_R=2.0
# RISK_MIN_PCT=0.8
# RISK_MAX_PCT=8.0
# ATR_PCT_MIN=0.5
# ATR_PCT_MAX=8.0
# MAX_ENTRY_GAP_PCT=3.0
# MAX_HOLD_DAYS=10

# --- Strateji parametreleri ---
# BREAKOUT_LOOKBACK=20
# BREAKOUT_MIN_TOUCHES=2
# BREAKOUT_RVOL=1.5
# BREAKOUT_RSI_MIN=55
# BREAKOUT_RSI_MAX=80
# RETEST_WINDOW=5
# PULLBACK_RVOL=1.2
# SUPPORT_LOOKBACK=40
# SQUEEZE_RANK=0.20
# SQUEEZE_RVOL=1.5

# --- Zamanlama ---
# INTRADAY_SCAN_EVERY_MIN=15
# PNL_EVERY_MIN=10
# DATA_DELAY_MIN=15
# DRY_RUN=false
